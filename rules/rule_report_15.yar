rule prompt_injection : ai_threat {
  meta:
    description = "Detects potential prompt injection attacks based on input patterns"
    author = "LLM Safety Team"
  strings:
    $long_input = { 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? }
    $rapid_query = { 28 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? }
  condition:
    any of ($long_input.*) and any of ($rapid_query.*)
}